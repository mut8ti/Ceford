---
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqs } from '../data/faqs.js';

// Search engines render this as a rich FAQ result.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="FAQs — CEFORED Institute of Relief"
  description="Answers to common questions about CEFORED Institute of Relief: who can enroll, online availability, how to apply, certification, and corporate training."
  schema={schema}
>

  <section class="section page-head">
    <div class="container">
      <h1 data-reveal>Frequently Asked Questions</h1>
      <p class="lede" data-reveal>
        Everything you need to know about enrolling, studying, and training your
        team with CEFORED.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="faq-list" data-reveal-group>
        {faqs.map(f => (
          <details class="faq">
            <summary>{f.q}</summary>
            <div class="faq-answer"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section band cta-band">
    <div class="container">
      <h2 class="section-title" data-reveal>Still have a question?</h2>
      <p class="lede">
        Our admissions team answers enquiries about intakes, fees, and group training.
      </p>
      <div class="btn-row" data-reveal>
        <a class="btn" href="/contact">Contact Us</a>
        <a class="btn btn-ghost" href="/programs">Browse Programs</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-head { padding-bottom: 0; text-align: center; }
  .page-head h1 { color: var(--brand); }
  html.dark-mode .page-head h1 { color: var(--accent); }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    max-width: 48rem;
    margin-inline: auto;
  }

  .faq {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .faq[open] { box-shadow: var(--shadow-lg); }

  .faq > summary {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-s) var(--space-m);
    font-size: var(--fs-400);
    font-weight: 600;
    color: var(--brand);
    cursor: pointer;
    list-style: none;
  }
  html.dark-mode .faq > summary { color: var(--accent); }
  .faq > summary::-webkit-details-marker { display: none; }
  .faq > summary:hover { background: var(--surface-2); }

  .faq > summary::after {
    content: "";
    flex: none;
    width: 0.55em;
    height: 0.55em;
    margin-left: auto;
    border-right: 2px solid var(--text-muted);
    border-bottom: 2px solid var(--text-muted);
    transform: rotate(45deg) translate(-0.12em, -0.12em);
    transition: transform 0.3s;
  }
  .faq[open] > summary::after {
    transform: rotate(-135deg) translate(-0.12em, -0.12em);
  }

  .faq-answer {
    padding: var(--space-s) var(--space-m) var(--space-m);
    border-top: 1px solid var(--border);
    background: var(--surface-2);
  }
  .faq-answer p { margin: 0; }

  .cta-band .lede { margin-bottom: var(--space-m); }
</style>
