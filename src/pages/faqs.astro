---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Button from '../components/Button.astro';
import Accordion from '../components/Accordion.astro';
import AccordionItem from '../components/AccordionItem.astro';
import { faqs } from '../data/faqs.js';

// Search engines render this as a rich FAQ result.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="FAQs — CEFORED Institute of Relief"
  description="Answers to common questions about CEFORED Institute of Relief: who can enroll, online availability, how to apply, certification, and corporate training."
  schema={schema}
>

  <PageHead
    title="Frequently Asked Questions"
    lede="Everything you need to know about enrolling, studying, and training your team with CEFORED."
  />

  <section class="section">
    <div class="container">
      <Accordion width="48rem" data-reveal-group>
        {faqs.map(f => (
          <AccordionItem>
            <Fragment slot="summary">{f.q}</Fragment>
            <p class="faq-answer-text">{f.a}</p>
          </AccordionItem>
        ))}
      </Accordion>
    </div>
  </section>

  <section class="section band cta-band">
    <div class="container">
      <h2 class="section-title" data-reveal>Still have a question?</h2>
      <p class="lede">
        Our admissions team answers enquiries about intakes, fees, and group training.
      </p>
      <div class="btn-row" data-reveal>
        <Button href="/contact">Contact Us</Button>
        <Button href="/programs" variant="ghost">Browse Programs</Button>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .faq-answer-text { margin: 0; }

  .cta-band .lede { margin-bottom: var(--space-m); }
</style>
