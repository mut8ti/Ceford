---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import Hero from '../components/Hero.astro';
import { realms } from '../data/realms.js';

const realmBlurbs = {
  logistics:            'Empowering supply chain professionals with AI tools to optimize procurement, inventory, fleet, and warehouse operations.',
  business:             'Redefining business strategy through automation, intelligent analytics, and AI-driven decision-making.',
  health:               'Revolutionizing patient care, data management, and healthcare delivery with artificial intelligence.',
  'project-management': 'Equipping project leaders to drive smarter execution, risk mitigation, resource optimization, and collaboration.',
  'it-digital':         'Driving innovation through digital infrastructure, cloud, cybersecurity, and AI-powered systems.',
  humanitarian:         'Enhancing crisis response, mapping, early warning, resource allocation, and coordination with intelligent tools.',
};

const values = [
  ['shield-check', 'Integrity',  'We are accountable to the communities and organizations we serve.'],
  ['heart-handshake', 'Compassion', 'Our work begins with the people affected by crisis and inequity.'],
  ['award', 'Excellence',  'Practical, rigorous training measured by what graduates can actually do.'],
  ['users', 'Community',   'An alumni network that keeps working together long after the course ends.'],
];
---

<BaseLayout
  title="About Us — CEFORED Institute of Relief"
  description="CEFORED Institute of Relief and Development is a pioneering training institute leveraging AI to transform learning in logistics, business, health, project management, IT, and humanitarian response."
  preloadImage="/images/about1.webp"
  ogImage="/images/about1.webp"
>

  <Hero
    image="/images/about1.webp"
    eyebrow="Who we are"
    title="About CEFORED"
    lede="A pioneering training institute leveraging the power of AI to transform learning in the sectors that drive social impact."
  />

  <section class="section">
    <div class="container mv-grid">
      <Card pad="l" class="mv-card" data-reveal="left">
        <Icon name="lucide:target" class="mv-icon" />
        <h2>Our Mission</h2>
        <p>
          To build a smarter, more resilient world through practical, AI-empowered
          education. We specialize in real-time, AI-enhanced training programs in
          logistics, business management, health systems, project management,
          humanitarian relief, and digital transformation.
        </p>
      </Card>
      <Card pad="l" class="mv-card" data-reveal="right">
        <Icon name="lucide:telescope" class="mv-icon" />
        <h2>Our Vision</h2>
        <p>
          To become Africa's most trusted institute for AI-integrated professional
          training that accelerates development and humanitarian impact.
        </p>
      </Card>
    </div>
  </section>

  <section class="section why-band band">
    <div class="container">
      <h2 class="section-title" data-reveal>Our Six Realms of Transformation</h2>
      <p class="lede">
        Our AI-driven vision is delivered through six realms of training and
        innovation, equipping professionals to lead in critical sectors.
      </p>
      <div class="realm-grid" data-reveal-group="scale">
        {realms.map(r => (
          <Card href={`/realms/${r.slug}`} class="realm-card">
            <Icon name={`lucide:${r.icon}`} class="realm-card-icon" />
            <h3>{r.title}</h3>
            <p>{realmBlurbs[r.slug]}</p>
            <span class="realm-card-more">Explore realm →</span>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title" data-reveal>Our Values</h2>
      <div class="value-grid" data-reveal-group>
        {values.map(([icon, name, text]) => (
          <Card class="value">
            <Icon name={`lucide:${icon}`} class="icon-accent icon-lg" />
            <h3>{name}</h3>
            <p>{text}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="section team-section">
    <div class="container">
      <Card pad="l" class="team" data-reveal>
        <h2>Our Team</h2>
        <p>
          Our staff and volunteers are experienced professionals committed to relief
          and development work, bringing field experience from NGOs, government
          agencies, and international organizations.
        </p>
        <div class="btn-row">
          <Button href="/programs">Explore Programs</Button>
          <Button href="/contact">Work With Us</Button>
        </div>
      </Card>
    </div>
  </section>

</BaseLayout>

<style>
  .mv-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-m);
  }
  .mv-icon { width: 2.2em; height: 2.2em; color: var(--accent); }
  .mv-card h2 { font-size: var(--fs-600); color: var(--brand-fg); }

  .realm-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-m);
  }
  .realm-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }
  .realm-card-icon { width: 2em; height: 2em; color: var(--accent); }
  .realm-card h3 { font-size: var(--fs-500); color: var(--brand-fg); margin: 0; }
  .realm-card p { color: var(--text-muted); font-size: var(--fs-200); }
  .realm-card-more {
    margin-top: auto;
    font-size: var(--fs-200);
    font-weight: var(--fw-semibold);
    color: var(--brand-fg);
  }

  .value-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-m);
  }
  .value {
    text-align: center;
  }
  .value h3 { font-size: var(--fs-500); color: var(--brand-fg); }
  .value p { color: var(--text-muted); font-size: var(--fs-200); margin: 0; }

  .team {
    max-width: 46rem;
    margin-inline: auto;
    text-align: center;
  }
  .team h2 { color: var(--brand-fg); }
  .team .btn-row { margin-top: var(--space-m); }
</style>
