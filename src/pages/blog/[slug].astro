---
import { Icon } from 'astro-icon/components';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';
import Badge from '../../components/Badge.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { Content } = await render(post);
const others = posts.filter(p => p.id !== post.id);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  keywords: post.data.tags.join(', '),
  publisher: {
    '@type': 'EducationalOrganization',
    name: 'CEFORED Institute of Relief and Development',
  },
};
---

<BaseLayout
  title={`${post.data.title} — CEFORED Institute of Relief`}
  description={post.data.description}
  pageType="article"
  schema={schema}
>

  <article>
    <header class="post-head">
      <div class="container">
        <Icon name={`ph:${post.data.icon}`} class="post-icon" />
        <div class="tags">
          {post.data.tags.map(t => <Badge variant="brand" size="sm">#{t.replace(/\s+/g, '')}</Badge>)}
        </div>
        <h1>{post.data.title}</h1>
        <p class="post-lede">{post.data.description}</p>
      </div>
    </header>

    <div class="container">
      <div class="post-body prose-center" data-reveal>
        <Content />
      </div>
    </div>
  </article>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal><h2>Keep reading</h2></div>
      <div class="more-grid" data-reveal-group="scale">
        {others.map(p => (
          <Card href={`/blog/${p.id}`} class="more-card">
            <Icon name={`ph:${p.data.icon}`} class="more-icon" />
            <h3>{p.data.title}</h3>
            <span class="more-link">Read the insight <Icon name="ph:arrow-right" /></span>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="section band cta-band">
    <div class="container">
      <h2 class="section-title" data-reveal>Turn insight into skills</h2>
      <p class="lede">
        Our six realms turn these trends into practical, certified training.
      </p>
      <div class="btn-row" data-reveal>
        <Button href="/programs">Explore Programs</Button>
        <Button href="/newsletter" variant="ghost">Subscribe</Button>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .post-head {
    padding: var(--space-xl) 0 var(--space-l);
    text-align: center;
    border-bottom: 1px solid var(--border);
  }
  .post-icon { width: 2.6em; height: 2.6em; color: var(--accent); }
  .post-head h1 { color: var(--brand-fg); max-width: 24ch; margin-inline: auto; }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    justify-content: center;
    margin-bottom: var(--space-2xs);
  }

  .post-lede {
    max-width: var(--measure);
    margin-inline: auto;
    font-size: var(--fs-400);
    color: var(--text-muted);
  }

  .post-body {
    padding-block: var(--space-l);
    font-size: var(--fs-400);
  }
  /* Markdown output is not scoped, so style it through the wrapper. */
  .post-body :global(h2) {
    margin-top: var(--space-l);
    font-size: var(--fs-600);
    color: var(--brand-fg);
  }
  .post-body :global(h3) {
    margin-top: var(--space-m);
    font-size: var(--fs-500);
  }
  .post-body :global(p) { margin-bottom: var(--space-s); }
  .post-body :global(ul) { padding-left: 1.2em; }
  .post-body :global(li) { margin-bottom: var(--space-3xs); }

  .more-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-m);
  }
  .more-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }
  .more-icon { width: 1.8em; height: 1.8em; color: var(--accent); }
  .more-card h3 { font-size: var(--fs-500); color: var(--brand-fg); margin: 0; }
  .more-link {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    margin-top: auto;
    font-size: var(--fs-200);
    font-weight: var(--fw-semibold);
    color: var(--brand-fg);
  }

  .cta-band .lede { margin-bottom: var(--space-m); }
</style>
