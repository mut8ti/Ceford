---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import PageHead from '../../components/PageHead.astro';
import Button from '../../components/Button.astro';
import Badge from '../../components/Badge.astro';

const posts = await getCollection('blog');
---

<BaseLayout
  title="Blog — CEFORED Institute of Relief"
  description="Insights, stories, and trends at the intersection of AI, education, and humanitarian impact."
>

  <PageHead
    title="Insights &amp; Stories"
    lede="Insights, stories, and trends at the intersection of AI, education, and humanitarian impact."
  />

  <section class="section">
    <div class="container">
      <div class="post-grid" data-reveal-group="scale">
        {posts.map(post => (
          <Card href={`/blog/${post.id}`} pad="l" class="post-card">
            <Icon name={`ph:${post.data.icon}`} class="post-icon" />
            <div class="tags">
              {post.data.tags.map(t => <Badge variant="brand" size="sm">#{t.replace(/\s+/g, '')}</Badge>)}
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <span class="post-more">Read the full insight <Icon name="ph:arrow-right" /></span>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="section band cta-band">
    <div class="container">
      <h2 class="section-title" data-reveal>Get these in your inbox</h2>
      <p class="lede">
        Subscribe for updates on programs, expert insights, and alumni stories.
      </p>
      <div class="btn-row" data-reveal>
        <Button href="/newsletter">Subscribe to Updates</Button>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-m);
  }

  .post-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .post-icon { width: 2.2em; height: 2.2em; color: var(--accent); }

  .tags { display: flex; flex-wrap: wrap; gap: var(--space-3xs); }

  .post-card h2 { font-size: var(--fs-500); color: var(--brand-fg); margin: 0; }
  .post-card p { color: var(--text-muted); font-size: var(--fs-200); }

  .post-more {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    margin-top: auto;
    font-size: var(--fs-200);
    font-weight: var(--fw-semibold);
    color: var(--brand-fg);
  }

  .cta-band .lede { margin-bottom: var(--space-m); }
</style>
