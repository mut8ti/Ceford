---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { realms } from '../data/realms.js';

const totalCourses = realms.reduce((n, r) => n + r.courses.length, 0);

const steps = [
  ['search', 'Choose your course',
   'Browse the six realms and pick the course that matches your role. Each listing states its objectives, audience, duration, and fee.'],
  ['send', 'Send your application',
   'Submit the contact form with the course you are interested in. Include any questions about prerequisites or intake dates.'],
  ['messages-square', 'Talk to admissions',
   'Our team confirms your eligibility, the next intake date, and payment details, and answers anything outstanding.'],
  ['graduation-cap', 'Enrol and begin',
   'Choose distance learning, live virtual classes, or in-person delivery. Certification follows successful completion.'],
];

const facts = [
  ['users',    'Who can enrol',  'Professionals, students, and organizations. Each course lists its ideal audience and prerequisites.'],
  ['monitor',  'How you study',  'Distance learning, live virtual classes, and in-person options for most programs.'],
  ['award',    'Certification',  'All programs include certification upon successful completion.'],
  ['building', 'Teams',          'Organizations can train whole cohorts through corporate packages.'],
];
---

<BaseLayout
  title="Admission — CEFORED Institute of Relief"
  description="How to apply to CEFORED Institute of Relief: choose a course from six AI-driven realms, apply through our admissions team, and study online, virtually, or in person."
>

  <section class="section page-head">
    <div class="container">
      <h1 data-reveal>Admission</h1>
      <p class="lede" data-reveal>
        {totalCourses} courses across six realms, open to professionals, students,
        and organizations. Here is how to join.
      </p>
      <div class="btn-row" data-reveal>
        <a class="btn" href="/contact">Start Your Application</a>
        <a class="btn" href="/programs">Browse Courses</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title" data-reveal>How to apply</h2>
      <ol class="steps" data-reveal-group="left">
        {steps.map(([icon, title, text], i) => (
          <li class="step">
            <span class="step-n">{i + 1}</span>
            <div>
              <h3><Icon name={`lucide:${icon}`} class="icon-accent" /> {title}</h3>
              <p>{text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title" data-reveal>Good to know</h2>
      <div class="fact-grid" data-reveal-group="scale">
        {facts.map(([icon, title, text]) => (
          <div class="fact">
            <Icon name={`lucide:${icon}`} class="fact-icon" />
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title" data-reveal>Courses &amp; fees</h2>
      <p class="lede">
        Fees are per learner. Expand a realm to see its courses, durations, and fees.
      </p>
      <div class="fee-list" data-reveal-group>
        {realms.map(r => (
          <details class="fee-realm">
            <summary>
              <Icon name={`lucide:${r.icon}`} class="fee-icon" />
              <span><strong>Realm {r.n}:</strong> {r.title}</span>
              <span class="fee-count">{r.courses.length}</span>
            </summary>
            <div class="fee-body">
              <table class="fee-table">
                <thead>
                  <tr><th>Course</th><th>Duration</th><th>Fee</th></tr>
                </thead>
                <tbody>
                  {r.courses.map(c => (
                    <tr>
                      <td>{c.name}</td>
                      <td>{c.duration || '—'}</td>
                      <td class="fee-cell">{c.fee || '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <a class="btn btn-sm" href={`/realms/${r.slug}`}>View realm details</a>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section band cta-band">
    <div class="container">
      <h2 class="section-title" data-reveal>Ready to apply?</h2>
      <p class="lede">
        Send us the course you are interested in and our admissions team will take
        it from there.
      </p>
      <div class="btn-row" data-reveal>
        <a class="btn" href="/contact">Apply Now</a>
        <a class="btn btn-ghost" href="/faqs">Read the FAQs</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-head { text-align: center; }
  .page-head h1 { color: var(--brand); }
  html.dark-mode .page-head h1 { color: var(--accent); }
  .page-head .btn-row { margin-top: var(--space-m); }

  .steps {
    display: grid;
    gap: var(--space-s);
    max-width: 48rem;
    margin-inline: auto;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-s);
    padding: var(--space-m);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .step-n {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--text-on-accent);
    font-weight: 700;
  }
  .step h3 {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    font-size: var(--fs-500);
    color: var(--brand);
  }
  html.dark-mode .step h3 { color: var(--accent); }
  .step p { margin: 0; color: var(--text-muted); }

  .fact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-m);
  }
  .fact {
    padding: var(--space-m);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .fact-icon { width: 1.9em; height: 1.9em; color: var(--accent); }
  .fact h3 { font-size: var(--fs-500); color: var(--brand); }
  html.dark-mode .fact h3 { color: var(--accent); }
  .fact p { margin: 0; font-size: var(--fs-200); color: var(--text-muted); }

  .fee-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    max-width: 52rem;
    margin-inline: auto;
  }
  .fee-realm {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .fee-realm > summary {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-s) var(--space-m);
    font-size: var(--fs-400);
    color: var(--brand);
    cursor: pointer;
    list-style: none;
  }
  html.dark-mode .fee-realm > summary { color: var(--accent); }
  .fee-realm > summary::-webkit-details-marker { display: none; }
  .fee-realm > summary:hover { background: var(--surface-2); }
  .fee-icon { width: 1.4em; height: 1.4em; color: var(--accent); }
  .fee-count {
    margin-left: auto;
    padding: 0.1em 0.6em;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text-muted);
    font-size: var(--fs-200);
    font-weight: 700;
  }

  .fee-body {
    padding: var(--space-s) var(--space-m) var(--space-m);
    border-top: 1px solid var(--border);
    background: var(--surface-2);
    overflow-x: auto;
  }
  .fee-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-200);
  }
  .fee-table th, .fee-table td {
    padding: var(--space-2xs) var(--space-xs);
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  .fee-table th {
    font-size: var(--fs-100);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .fee-cell { font-weight: 700; white-space: nowrap; }
  .fee-body .btn { margin-top: var(--space-s); }

  .cta-band .lede { margin-bottom: var(--space-m); }
</style>
