---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import PageHead from '../components/PageHead.astro';
import Button from '../components/Button.astro';
import { realms } from '../data/realms.js';
import { countryCodes } from '../data/country-codes.js';

const details = [
  ['mail',  'Email',    'info@cefored.com',            'mailto:info@cefored.com'],
  ['phone', 'Phone',    '+254 755 445 982',            'tel:+254755445982'],
  ['globe', 'Website',  'www.ceforedconsultancy.com',  'https://www.ceforedconsultancy.com'],
  ['map-pin', 'Location', 'Nairobi, Kenya',            null],
];
---

<BaseLayout
  title="Contact Us — CEFORED Institute of Relief"
  description="Reach CEFORED Institute of Relief for admissions, course registration, partnerships, or corporate training. Based in Nairobi, Kenya."
>

  <PageHead
    title="Contact Us"
    lede="For inquiries, course registration, partnership opportunities or corporate training requests, reach us through the form below or contact us directly."
  />

  <section class="section contact-section">
    <div class="container contact-grid">

      <Card
        as="form"
        pad="l"
        class="contact-form"
        data-firestore="contacts"
        data-success="Thank you for contacting us. We will get back to you soon."
        data-reveal
        novalidate
      >
        <h2>Send us a message</h2>

        <div class="field">
          <label for="name">Full name <span aria-hidden="true">*</span></label>
          <input class="input" type="text" id="name" name="name" required autocomplete="name" placeholder="Enter your full name" />
        </div>

        <div class="field">
          <label for="email">Email address <span aria-hidden="true">*</span></label>
          <input class="input" type="email" id="email" name="email" required autocomplete="email" placeholder="your.email@example.com" />
        </div>

        <div class="field">
          <label for="phone">Phone number <span class="hint">(optional)</span></label>
          <div class="phone-row">
            <select class="select" id="countryCode" name="countryCode" aria-label="Country dial code">
              {countryCodes.map(c => <option value={c.code}>{c.label}</option>)}
            </select>
            <input class="input" type="tel" id="phone" name="phone" autocomplete="tel-national" placeholder="712345678" />
          </div>
        </div>

        <div class="field">
          <label for="course">Course interest <span class="hint">(optional)</span></label>
          <select class="select" id="course" name="course">
            <option value="">Select a course</option>
            {realms.map(r => <option value={r.slug}>{r.title}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="message">Message</label>
          <textarea class="textarea" id="message" name="message" rows="5"
            placeholder="Tell us about your inquiry, goals, or any questions you have..."></textarea>
        </div>

        <div class="honeypot" aria-hidden="true">
          <label for="website">Leave this field empty</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <Button type="submit">Send message</Button>
        <p data-form-status=""></p>
      </Card>

      <Card as="aside" pad="l" class="contact-aside" data-reveal="right">
        <h2>Reach us directly</h2>
        <p>Let's ignite the future. Reach out for admissions, partnerships, or corporate collaborations.</p>
        <ul class="contact-list">
          {details.map(([icon, label, value, href]) => (
            <li>
              <Icon name={`lucide:${icon}`} class="icon-accent" />
              <span class="contact-label">{label}</span>
              {href
                ? <a href={href}>{value}</a>
                : <span>{value}</span>}
            </li>
          ))}
        </ul>
      </Card>

    </div>
  </section>

</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-l);
    align-items: start;
  }
  @media (max-width: 60rem) {
    .contact-grid { grid-template-columns: 1fr; }
  }

  .contact-form h2,
  .contact-aside h2 {
    font-size: var(--fs-500);
    color: var(--brand-fg);
  }

  .contact-list { margin: 0; padding: 0; list-style: none; }
  .contact-list li {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-2xs) 0;
    border-top: 1px solid var(--border);
  }
  .contact-label { font-weight: var(--fw-semibold); color: var(--text-muted); }
</style>

<script>
  import '../scripts/forms.js';
</script>
