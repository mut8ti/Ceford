---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';
import Accordion from '../../components/Accordion.astro';
import AccordionItem from '../../components/AccordionItem.astro';
import Hero from '../../components/Hero.astro';
import { realms } from '../../data/realms.js';

export function getStaticPaths() {
  return realms.map((realm) => ({ params: { slug: realm.slug }, props: { realm } }));
}

const { realm } = Astro.props;
const others = realms.filter((r) => r.slug !== realm.slug);

// Rich results for course listings.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Courses in ${realm.title}`,
  itemListElement: realm.courses.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Course',
      name: c.name,
      description: c.objectives || realm.overview,
      provider: {
        '@type': 'EducationalOrganization',
        name: 'CEFORED Institute of Relief and Development',
        sameAs: 'https://www.ceforedconsultancy.com',
      },
    },
  })),
};

const detailRows = [
  ['audience',     'Who it is for', 'users'],
  ['requirements', 'Requirements',  'clipboard-check'],
  ['duration',     'Duration',      'clock'],
];
---

<BaseLayout
  title={`Realm ${realm.n}: ${realm.title} — CEFORED Institute of Relief`}
  description={realm.overview}
  preloadImage={realm.bg}
  ogImage={realm.bg}
  schema={schema}
>

  <Hero
    image={realm.bg}
    icon={realm.icon}
    eyebrow={`Realm ${realm.n}`}
    title={realm.title}
    lede={realm.tagline}
  />

  <section class="section overview-section">
    <div class="container">
      <Card pad="l" class="overview" data-reveal>
        <h2>Program overview</h2>
        <p>{realm.overview}</p>
        {realm.idealFor && (
          <p class="ideal"><strong>Ideal for:</strong> {realm.idealFor}</p>
        )}
      </Card>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title" data-reveal>Courses Offered</h2>
      <p class="lede">
        {realm.courses.length} courses in this realm. Every course runs online,
        live-virtual, or in person.
      </p>

      <Accordion width="52rem" data-reveal-group>
        {realm.courses.map((course) => (
          <AccordionItem>
            <Fragment slot="summary">
              <span class="course-name">{course.name}</span>
              {course.fee && <span class="course-fee">{course.fee}</span>}
            </Fragment>
            {course.objectives && (
              <p class="course-objectives">{course.objectives}</p>
            )}
            <dl class="course-meta">
              {detailRows.map(([key, label, icon]) => course[key] && (
                <div class="meta-row">
                  <dt><Icon name={`lucide:${icon}`} class="icon-accent" /> {label}</dt>
                  <dd>{course[key]}</dd>
                </div>
              ))}
              {course.fee && (
                <div class="meta-row">
                  <dt><Icon name="lucide:tag" class="icon-accent" /> Course fee</dt>
                  <dd>{course.fee}</dd>
                </div>
              )}
            </dl>
            <Button href="/contact" size="sm">Apply for this course</Button>
          </AccordionItem>
        ))}
      </Accordion>
    </div>
  </section>

  <section class="section band cta-band">
    <div class="container">
      <h2 class="section-title" data-reveal>Ready to start?</h2>
      <p class="lede">
        Talk to our admissions team about intake dates, group rates, and
        organization-wide training.
      </p>
      <div class="btn-row" data-reveal>
        <Button href="/admission">Apply Now</Button>
        <Button href="/contact" variant="ghost">Contact Admissions</Button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title" data-reveal>Explore other realms</h2>
      <div class="realm-links" data-reveal-group="scale">
        {others.map((r) => (
          <Card href={`/realms/${r.slug}`} class="realm-link">
            <Icon name={`lucide:${r.icon}`} class="realm-link-icon" />
            <span class="realm-link-n">Realm {r.n}</span>
            <span class="realm-link-title">{r.title}</span>
          </Card>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---------- Overview ---------- */
  .overview-section { padding-top: var(--space-l); }

  .overview {
    max-width: 52rem;
    margin-inline: auto;
  }
  .overview h2 { font-size: var(--fs-600); color: var(--brand-fg); }
  .ideal { margin-bottom: 0; color: var(--text-muted); }

  /* ---------- Courses ---------- */

  .course > summary {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-s) var(--space-m);
    cursor: pointer;
    list-style: none;
  }

  .course-name {
    flex: 1;
    font-size: var(--fs-400);
    font-weight: var(--fw-semibold);
    color: var(--brand-fg);
  }

  .course-fee {
    flex: none;
    padding: 0.15em 0.6em;
    border-radius: 999px;
    background: var(--accent);
    color: var(--text-on-accent);
    font-size: var(--fs-200);
    font-weight: var(--fw-bold);
  }

  .course-objectives { font-weight: var(--fw-semibold); }

  .course-meta { margin: 0 0 var(--space-s); }
  .meta-row {
    display: grid;
    grid-template-columns: minmax(9rem, auto) 1fr;
    gap: var(--space-2xs) var(--space-s);
    padding: var(--space-2xs) 0;
    border-top: 1px solid var(--border);
  }
  .meta-row dt {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    font-weight: var(--fw-semibold);
    color: var(--text-muted);
  }
  .meta-row dd { margin: 0; }

  @media (max-width: 34rem) {
    .meta-row { grid-template-columns: 1fr; gap: 0; }
  }

  /* ---------- Other realms ---------- */
  .realm-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-m);
  }

  .realm-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .realm-link-icon { width: 1.9em; height: 1.9em; color: var(--accent); }
  .realm-link-n {
    font-size: var(--fs-100);
    font-weight: var(--fw-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .realm-link-title { font-weight: var(--fw-semibold); color: var(--brand-fg); }

  .cta-band .lede { margin-bottom: var(--space-m); }
</style>
