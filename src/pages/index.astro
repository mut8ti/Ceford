---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import RealmIndex from '../components/RealmIndex.astro';
import { realms } from '../data/realms.js';

const totalCourses = realms.reduce((n, r) => n + r.courses.length, 0);

const reasons = [
  ['Trusted by the sector',   'NGOs, government bodies, and international organizations send their teams to us.'],
  ['Tools, not theory',       'Every course works with the software and datasets used on the job.'],
  ['Written for a named role','Courses state the job titles they are for, and the prerequisites they assume.'],
  ['Study how you need to',   'Distance learning, live virtual classes, or in person.'],
  ['Certified on completion', 'All programs carry certification backed by applied AI coursework.'],
  ['An alumni network',       'Graduates working across East Africa and beyond, still in touch.'],
];

const testimonials = [
  ['We overhauled our disaster preparedness program with CEFORED’s AI approach. Incredible impact.', 'John K.', 'Humanitarian Director'],
  ['The business strategy course gave us tools we now use daily. Worth every dollar.', 'Mary N.', 'SME Owner'],
  ['CEFORED’s training brought real transformation to our health systems. The AI dashboards are now central to how we operate.', 'Dr. Amina L.', 'Regional Health Officer'],
];

const partners = [
  ['UNlogo.webp', 'UN'], ['UNDPlogo.webp', 'UNDP'], ['UNICEFlogo.webp', 'UNICEF'],
  ['FAO_logo.svg', 'FAO'], ['NRClogo.webp', 'NRC'], ['carekenya.webp', 'CARE Kenya'],
  ['worldvisionlogo.webp', 'World Vision'], ['OXFAMlogo.webp', 'OXFAM'],
  ['savethechildren.webp', 'Save the Children UK'], ['MSFlogo.webp', 'MSF'],
  ['Actionagainsthungerlogo.webp', 'Action Against Hunger'], ['VSF-LOGO.webp', 'VSF'],
];
---

<BaseLayout
  title="CEFORED Institute of Relief — AI Training for Relief, Health and Supply Chain Work"
  description="Applied AI training in logistics, business, health, project management, IT and humanitarian response. 29 courses for working professionals across East Africa."
  ogImage="/images/realms/humanitarian.webp"
>

  {/* Animated in CSS rather than GSAP on purpose. GSAP is a dynamic import, so
      gating the h1 reveal on it would hold the largest contentful paint until
      that module lands. Reduced motion collapses these durations through the
      global rule in tokens.css, and with JS off it still runs. */}
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow"><span>Nairobi, Kenya</span></p>

      <h1>
        <span class="line"><span>AI training for relief,</span></span>
        <span class="line"><span>health, and supply chain work.</span></span>
      </h1>

      <p class="hero-lede">
        {totalCourses} courses for logistics officers, health administrators, M&amp;E staff,
        camp managers, and the teams they work in. Three to four weeks, online or in person.
      </p>

      <div class="hero-actions">
        <Button href="/programs">Explore programs</Button>
        <Button href="/admission" variant="ghost">Apply now</Button>
      </div>
    </div>
  </section>

  <section class="section realms-section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Six realms, {totalCourses} courses</h2>
        <dl class="terms">
          <div><dt>Length</dt><dd>3–4 weeks</dd></div>
          <div><dt>Fee</dt><dd>$450–490</dd></div>
        </dl>
      </div>
      <RealmIndex />
    </div>
  </section>

  <section class="section why">
    <div class="container">
      <div class="section-head" data-reveal><h2>Why CEFORED</h2></div>
      <ol class="reasons" data-reveal-group="left">
        {reasons.map(([title, text], i) => (
          <li>
            <span class="reason-n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal><h2>Testimonials</h2></div>
      <div class="quote-grid" data-reveal-group>
        {testimonials.map(([quote, name, role]) => (
          <Card as="figure" pad="l" class="quote">
            <Icon name="lucide:quote" class="icon-accent icon-lg" />
            <p>{quote}</p>
            <figcaption><strong>{name}</strong><span>{role}</span></figcaption>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="section band partners">
    <div class="container">
      <h2 class="section-title" data-reveal>Partners &amp; Accreditation</h2>
      <p class="lede">
        We train alongside the organizations shaping humanitarian and development
        work across the region.
      </p>
    </div>

    {/* Marquee: the track holds two identical copies of the logo list and
        scrolls exactly -50%, so the loop is seamless. The second copy is
        aria-hidden so screen readers announce each partner once. */}
    <div class="marquee">
      <div class="marquee-track">
        {[0, 1].map(copy => (
          <ul class="marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
            {partners.map(([file, name]) => (
              <li>
                <span class="partner-tile">
                  <img src={`/images/${file}`} alt={copy === 0 ? name : ''} loading="lazy" />
                </span>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding-block: var(--space-2xl) var(--space-xl);
    overflow: hidden;
  }

  /* A faint line grid fading out downward, so the hero has some structure
     without a photograph doing the work. Same technique as .band. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right,  var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: var(--grid-size) var(--grid-size);
    mask-image: linear-gradient(to bottom, #000, transparent 85%);
  }

  .hero-inner { position: relative; max-width: 64rem; }

  .hero h1 {
    font-size: var(--fs-900);
    font-weight: var(--fw-display);
    letter-spacing: var(--ls-display);
    line-height: 1.02;
    margin-bottom: var(--space-m);
    text-wrap: initial;   /* the line breaks are authored, not balanced */
  }

  /* Each line is masked by its own overflow, so the text slides up out of
     nothing. The padding/margin pair stops the mask clipping descenders. */
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }
  .line > span {
    display: block;
    animation: rise 1s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }
  .line:nth-child(1) > span { animation-delay: 0.08s; }
  .line:nth-child(2) > span { animation-delay: 0.2s; }

  @keyframes rise {
    from { transform: translateY(105%); }
  }

  .eyebrow {
    overflow: hidden;
    margin-bottom: var(--space-s);
    font-size: var(--fs-100);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .eyebrow > span {
    display: block;
    animation: rise 0.8s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  .hero-lede,
  .hero-actions {
    animation: fade-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }
  .hero-lede {
    max-width: 54ch;
    margin-bottom: var(--space-l);
    font-size: var(--fs-400);
    color: var(--text-muted);
    animation-delay: 0.36s;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    animation-delay: 0.46s;
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(1.2rem); }
  }

  /* ---------- Realm index ---------- */
  .realms-section { padding-top: var(--space-l); }

  .terms { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-m); margin: 0; }
  .terms > div { display: flex; flex-direction: column; }
  .terms dt {
    font-size: var(--fs-100);
    font-weight: var(--fw-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .terms dd { margin: 0; font-size: var(--fs-200); font-weight: var(--fw-semibold); }

  /* ---------- Why ---------- */
  .why {
    background: var(--surface);
    border-block: 1px solid var(--border);
  }

  .reasons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-l) var(--space-xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .reasons li { display: grid; gap: var(--space-3xs); align-content: start; }
  .reason-n {
    font-size: var(--fs-200);
    font-weight: var(--fw-medium);
    letter-spacing: 0.1em;
    color: var(--accent-ink);
    font-variant-numeric: tabular-nums;
  }
  .reasons h3 { font-size: var(--fs-500); margin: 0; color: var(--brand-fg); }
  .reasons p { margin: 0; color: var(--text-muted); }

  /* ---------- Testimonials ---------- */
  .quote-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-m);
  }
  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin: 0;
    text-align: left;
  }
  .quote p { font-size: var(--fs-400); font-style: italic; }
  .quote figcaption {
    display: flex;
    flex-direction: column;
    margin-top: auto;
    padding-top: var(--space-xs);
    border-top: 1px solid var(--border);
    font-size: var(--fs-200);
  }
  .quote figcaption strong { color: var(--brand-fg); }
  .quote figcaption span { color: var(--text-muted); }

  /* ---------- Partners marquee ---------- */
  .partners { padding-bottom: var(--space-xl); }

  .marquee {
    overflow: hidden;
    /* Fade the ends so logos enter and leave instead of being cut off. */
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 45s linear infinite;
  }
  .marquee:hover .marquee-track { animation-play-state: paused; }

  @keyframes marquee-scroll {
    to { transform: translateX(-50%); }
  }

  .marquee-group {
    display: flex;
    flex: none;
    gap: var(--space-s);
    margin: 0;
    padding: 0 calc(var(--space-s) / 2);
    list-style: none;
  }

  .partner-tile {
    display: grid;
    place-items: center;
    width: 11rem;
    height: 5.5rem;
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius);
    background: #fff;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.18);
  }

  /* An explicit height, not max-height: a percentage against an auto-sized
     grid row is cyclic and browsers drop it, which let the logos overflow. */
  .partner-tile img {
    height: 3rem;
    width: 100%;
    object-fit: contain;
  }

  /* No motion: drop the animation and let the row scroll by hand instead. */
  @media (prefers-reduced-motion: reduce) {
    .marquee { overflow-x: auto; }
    .marquee-track { animation: none; }
  }
</style>
