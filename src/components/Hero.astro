---
/* The photo hero, previously copy-pasted into five pages. The background image
   arrives as a custom property so one rule serves every page.

   Anything passed as children renders below the lede — that slot exists for the
   button row, which only some pages carry. */
import { Icon } from 'astro-icon/components';

/* `position` is the background-position — some photos need the crop nudged so
   faces aren't cut off by the scrim. */
const { title, eyebrow, lede, image, icon, size = 'md', position = 'center' } = Astro.props;
---

<section
  class:list={['hero', size === 'lg' && 'hero-lg']}
  data-hero
  style={`--hero-image: url("${image}"); --hero-position: ${position}`}
>
  <div class="hero-inner">
    {eyebrow && (
      <p class="eyebrow" data-hero-item>
        {icon && <Icon name={`lucide:${icon}`} />}
        {eyebrow}
      </p>
    )}

    {/* Not animated: this is the LCP element on every page it appears on. */}
    <h1>{title}</h1>

    {lede && <p class="hero-lede" data-hero-item>{lede}</p>}

    <slot />
  </div>
</section>

<style>
  /* The scrim fades from dark at the top to the page background at the bottom,
     so the hero dissolves into the page instead of ending on a hard edge. */
  .hero {
    display: grid;
    place-items: center;
    min-height: min(58vh, 460px);
    padding: var(--space-2xl) var(--space-m) var(--space-xl);
    text-align: center;
    color: #fff;
    background-image:
      linear-gradient(
        180deg,
        var(--hero-scrim-top) 0%,
        var(--hero-scrim-mid) 48%,
        color-mix(in srgb, var(--bg) 60%, transparent) 86%,
        var(--bg) 100%
      ),
      var(--hero-image);
    background-size: cover;
    background-position: var(--hero-position);
  }

  /* The homepage only. Every other hero is the shorter variant, so the home
     page still reads as the front door. */
  .hero-lg { min-height: min(78vh, 640px); }

  .hero-inner { max-width: 46rem; }

  .eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    margin-bottom: var(--space-2xs);
    font-size: var(--fs-200);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    /* The backdrop here is always the dark scrim, never the page, so this can
       take the brighter amber that would be too light on a white surface. */
    color: var(--accent-on-dark);
  }

  .hero h1 { text-shadow: 0 2px 12px rgb(0 0 0 / 0.55); }

  .hero-lede {
    margin-bottom: var(--space-l);
    font-size: var(--fs-400);
    color: rgb(255 255 255 / 0.92);
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.6);
  }
  /* Nothing in the slot, so nothing to leave room for. */
  .hero-lede:last-child { margin-bottom: 0; }
</style>
