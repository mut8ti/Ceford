---
/* Renders an <a> when given an href and a <button> otherwise, so a link is
   never faked with a click handler and a submit is never faked with an anchor.

   The .btn styles stay in base.css alongside the rest of the shell. They are
   global on purpose: scoping them here would break any markup still written as
   <a class="btn">, and the hover fill needs no per-instance markup. */
const {
  href,
  variant,            // 'ghost'
  size,               // 'sm'
  type = 'button',    // ignored when href is present
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn', variant && `btn-${variant}`, size && `btn-${size}`, className]}
  href={href}
  type={href ? undefined : type}
  {...rest}
>
  <slot />
</Tag>
