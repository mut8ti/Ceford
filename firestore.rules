rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // CONTACT FORM SUBMISSIONS
    match /contacts/{contactId} {
      // Create allowed with required fields & optional phone/course/message
      allow create: if
        request.resource.data.keys().hasAll(['name','email','source']) &&
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        request.resource.data.source == 'contact-form' &&
        (!('phone' in request.resource.data) || request.resource.data.phone is string) &&
        (!('course' in request.resource.data) || request.resource.data.course is string) &&
        (!('message' in request.resource.data) || request.resource.data.message is string) &&
        request.resource.data.keys().hasOnly(['name','email','message','source','phone','course', 'timestamp']);

      // Admin operations (requires admins/{uid}.role == 'admin')
      allow read, update, delete: if
        request.auth != null &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // NEWSLETTER SUBSCRIPTIONS
    match /newsletter/{subscriberId} {
      allow create: if
        // Require essential fields
        request.resource.data.keys().hasAll(['name','email','status']) &&
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        request.resource.data.status == 'subscribed' &&
        // Only allow these user-supplied keys (timestamp is now explicitly allowed)
        request.resource.data.keys().hasOnly(['name','email','status', 'timestamp']);

      allow read, update, delete: if
        request.auth != null &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // Admin read access to everything else
    match /{document=**} { // <--- Corrected line here!
      allow read: if
        request.auth != null &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
