# Enable GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Set Cache-Control headers
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Set default expiry to 1 month
    ExpiresDefault "access plus 1 month"
    
    # Images
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    
    # HTML - no caching, always fresh
    ExpiresByType text/html "access plus 0 seconds"
    
    # Fonts
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType application/x-font-opentype "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>

# Add Cache-Control headers
<IfModule mod_headers.c>
    # 1 YEAR - doesn't change often
    <FilesMatch "\.(webp|jpg|jpeg|png|gif|ico|svg)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    
    # 1 MONTH - may be updated
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    
    # NEVER CACHE - always fresh
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# Prevent viewing of .htaccess file
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>

# Prevent directory listings
Options -Indexes

# Security Headers
<IfModule mod_headers.c>
    # Content Security Policy
    # connect-src MUST list the Firebase hosts or the contact and newsletter
    # forms fail silently in production. Fonts are self-hosted now, and the
    # Font Awesome CDN is gone, so both are dropped from the allowlist.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://firestore.googleapis.com https://firebase.googleapis.com https://www.googleapis.com https://identitytoolkit.googleapis.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self';"
    
    # HSTS (HTTP Strict Transport Security)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # X-Frame-Options
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # X-Content-Type-Options
    Header always set X-Content-Type-Options "nosniff"
    
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# URL Rewriting for clean URLs
RewriteEngine On

# ---------------------------------------------------------------------------
# Legacy URL redirects (301). The rewrite added .html-stripping, but the old
# page NAMES changed too, so without these every indexed URL 404s.
# Must come BEFORE the generic clean-URL rules below.
# ---------------------------------------------------------------------------
RewriteRule ^index\.html?$                      /                              [R=301,L]
RewriteRule ^about\.html?$                      /about                         [R=301,L]
RewriteRule ^programs\.html?$                   /programs                      [R=301,L]
RewriteRule ^faqs\.html?$                       /faqs                          [R=301,L]
RewriteRule ^contact\.html?$                    /contact                       [R=301,L]
RewriteRule ^newsletter\.html?$                 /newsletter                    [R=301,L]
RewriteRule ^admission\.html?$                  /admission                     [R=301,L]
RewriteRule ^blog\.html?$                       /blog                          [R=301,L]

# Renamed pages
RewriteRule ^corporatetraining\.html?$          /corporate-training            [R=301,L]

# Blog posts
RewriteRule ^blog1AIcrisisResponse\.html?$      /blog/ai-crisis-response       [R=301,L]
RewriteRule ^blog2DigitalHumanitarian\.html?$   /blog/digital-humanitarian-tools [R=301,L]
RewriteRule ^blog4EmergingTrendsAI\.html?$      /blog/emerging-trends-ai       [R=301,L]

# Realm pages
RewriteRule ^realm1-logistics\.html?$           /realms/logistics              [R=301,L]
RewriteRule ^realm2-business\.html?$            /realms/business               [R=301,L]
RewriteRule ^realm3-health\.html?$              /realms/health                 [R=301,L]
RewriteRule ^realm4-project\.html?$             /realms/project-management     [R=301,L]
RewriteRule ^realm5-it\.html?$                  /realms/it-digital             [R=301,L]
RewriteRule ^realm6-humanitarian\.html?$        /realms/humanitarian           [R=301,L]

# Dev/test pages that were publicly reachable. 410 tells search engines to
# drop them immediately rather than keep retrying a redirect.
RewriteRule ^(test-contact|test-firebase|performance-test|optimization-template|security-meta)\.html?$ - [G,L]

# Custom error page
ErrorDocument 404 /404.html

# Remove .html extension from URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Redirect .html URLs to clean URLs
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1? [NC,L,R=301]
